{
  "version": 2,
  "note": "The QA checklist. Each item names the page types it applies to (roles), the automated rows that decide it (auto, globs over row ids; ! excludes) and rows shown to help a person judge it (evidence). Items with no auto rows, or whose rows did not run, are answered by the tester. Items with requires: campaigns-os appear only when a Campaigns OS verdict is part of the run. Item ids are readable names (for example toggle-timer); people see the title numbered within its section.",
  "roles": [
    "presell",
    "landing",
    "checkout",
    "upsell",
    "receipt",
    "storefront"
  ],
  "items": [
    {
      "id": "speed-test",
      "section": "Browser & performance",
      "text": "Speed test (PageSpeed / Lighthouse), mobile and desktop",
      "roles": [
        "presell",
        "landing",
        "checkout",
        "upsell",
        "receipt",
        "storefront"
      ],
      "severity": "warn",
      "auto": [
        "speed:*"
      ]
    },
    {
      "id": "webpagetest",
